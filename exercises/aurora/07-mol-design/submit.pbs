#!/bin/bash -l
# PBS submission for exercise 07 (07-mol-design) on Aurora (ALCF).
# Project is ATPESC2026; then:  qsub submit.pbs
#PBS -A ATPESC2026
#PBS -q debug
#PBS -l select=1:ncpus=208
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -N fca-07-mol-design
#PBS -j oe

set -euo pipefail
# PBS sets PBS_O_WORKDIR to the qsub dir; if unset (e.g. the script is run directly,
# not via qsub) default it to this script's own dir so cd/../env.sh/runs/ still resolve.
: "${PBS_O_WORKDIR:=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
cd "$PBS_O_WORKDIR"

# Put the job's stdout/stderr in the SAME runs/<id>_<date-time>/ dir as the provenance:
# pre-create it (timestamp format matches util.new_run_dir), pass it to Python via
# FLOWCEPT_RUN_DIR (capture_run reuses it), then redirect this job's output into it.
# The PBS -j oe file keeps only the pointer line below plus any pre-redirect error.
export FLOWCEPT_RUN_DIR="$PBS_O_WORKDIR/runs/07-mol-design_$(date +%Y%m%d-%H%M%S)"
mkdir -p "$FLOWCEPT_RUN_DIR"
echo "job + provenance -> $FLOWCEPT_RUN_DIR/"
exec >"$FLOWCEPT_RUN_DIR/job.out" 2>"$FLOWCEPT_RUN_DIR/job.err"

source ../env.sh                 # one conda env (rdkit+ase+xtb + agents/LLM) + Flowcept settings

# 07's LangGraph tool_calling node NEEDS a model that emits real tool calls. vLLM is the
# only LLM backend on Aurora (there is no CPU fallback); vllm_start serves the staged
# Llama-3.1-8B with --enable-auto-tool-choice on this node's GPUs.
# (If you do have Argo reachability: `export FLOWCEPT_TUTORIAL_LLM=argo ARGO_USER=... FLOWCEPT_USE_VLLM=0`.)
if [[ "${FLOWCEPT_USE_VLLM:-1}" == 1 ]]; then
    source ../vllm_serve.sh
    vllm_start
elif [[ -z "${ARGO_USER:-}" ]]; then
    echo "!! 07 needs tool calling: either leave FLOWCEPT_USE_VLLM=1 or set ARGO_USER."
    exit 1
fi

# If `conda activate` didn't take in this non-interactive job, run via conda:
if python -c "import xtb" 2>/dev/null; then
    python solution.py           # (use exercise.py to work through the steps)
else
    conda run --no-capture-output -p "$FLOWCEPT_ENV_PREFIX" python solution.py
fi

echo "provenance -> $FLOWCEPT_RUN_DIR/  (job.out, job.err, buffer, perf CSV, 07-mol-design_card.md)"
