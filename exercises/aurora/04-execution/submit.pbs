#!/bin/bash -l
# PBS submission for exercise 04 (04-execution) on Aurora (ALCF).
# Project is ATPESC; then:  qsub submit.pbs
#PBS -A ATPESC
#PBS -q debug
#PBS -l select=1:ncpus=208
#PBS -l walltime=00:20:00
#PBS -l filesystems=home:flare
#PBS -N fca-04-execution
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"
source ../env.sh                 # modules + conda env + offline LLM + Flowcept settings

python solution.py               # (use exercise.py to work through the steps)

echo "provenance -> $PBS_O_WORKDIR/runs/04-execution_<date-time>/  (buffer, perf CSV, 04-execution_card.md)"
