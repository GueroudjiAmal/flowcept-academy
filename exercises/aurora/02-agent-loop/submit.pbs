#!/bin/bash -l
# PBS submission for exercise 02 (02-agent-loop) on Aurora (ALCF).
# Project is ATPESC2026; then:  qsub submit.pbs
#PBS -A ATPESC2026
#PBS -q debug
#PBS -l select=1:ncpus=208
#PBS -l walltime=00:20:00
#PBS -l filesystems=home:flare
#PBS -N fca-02-agent-loop
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"
source ../env.sh                 # modules + conda env + offline LLM + Flowcept settings

python solution.py               # (use exercise.py to work through the steps)

echo "provenance -> $PBS_O_WORKDIR/runs/02-agent-loop_<date-time>/  (buffer, perf CSV, 02-agent-loop_card.md)"
